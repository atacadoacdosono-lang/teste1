# Porta em que o servidor local roda
PORT=3000

# Evolution API — sua instância self-hosted de WhatsApp
EVOLUTION_API_URL=https://sua-instancia-evolution.exemplo.com
EVOLUTION_API_KEY=coloque-sua-chave-aqui

# Segredo simples pra confirmar que o webhook realmente veio da sua instância Evolution.
# Configure a mesma string na URL do webhook (?secret=...) dentro do painel da Evolution API.
WEBHOOK_SECRET=escolha-um-segredo-aleatorio

# Claude (Anthropic) — https://console.anthropic.com
ANTHROPIC_API_KEY=coloque-sua-chave-aqui
ANTHROPIC_MODEL=claude-opus-5
# Nível de esforço do modelo: low | medium | high — medium é um bom equilíbrio de
# custo x qualidade para respostas de chat curtas. Baixe para "low" se o volume
# de mensagens for grande e o custo por conversa importar mais que nuance.
ANTHROPIC_EFFORT=medium
