# Copie este arquivo para ".env" e preencha com seus dados.
# Pegue as credenciais em: https://www.mercadopago.com.br/developers/panel/app
# Para testar, use as credenciais de TESTE (começam com "TEST-").

# Chave secreta (fica SÓ no servidor, nunca no navegador)
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# Chave pública (pode ir para o navegador, serve para o formulário de cartão)
MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000

# Assinatura secreta dos webhooks (painel do Mercado Pago > Webhooks)
MP_WEBHOOK_SECRET=

# Endereço público do seu site (precisa ser https para o Mercado Pago avisar os pagamentos)
BASE_URL=http://localhost:3000

# Senha para abrir o painel de pedidos em /admin.html
ADMIN_PASSWORD=troque-esta-senha

PORT=3000
