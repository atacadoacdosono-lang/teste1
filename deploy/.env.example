# Chave que a Evolution API vai exigir em todas as chamadas de API
# (é o mesmo valor que vai no EVOLUTION_API_KEY do backend/.env)
EVOLUTION_API_KEY=escolha-uma-chave-aleatoria-longa

# Senha do banco de dados interno da Evolution API (não precisa decorar,
# só usada entre os containers)
POSTGRES_PASSWORD=escolha-outra-senha-aleatoria
